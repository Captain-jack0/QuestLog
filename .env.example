# Copy to .env.local (repo root) and fill in from Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: error reporting. Left empty (and in dev) Sentry stays off.
VITE_SENTRY_DSN=

# Optional: web push. Public half of the VAPID pair (npx web-push generate-vapid-keys).
# The private half is a Supabase function secret, never a VITE_ variable.
VITE_VAPID_PUBLIC_KEY=

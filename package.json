{
  "name": "questlog",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "typecheck": "npm run typecheck -w apps/web",
    "lint": "npm run lint -w apps/web",
    "test": "npm run test -w apps/web",
    "test:e2e": "playwright test",
    "test:db": "npx --yes supabase test db",
    "db:migrate": "npx --yes supabase migration up",
    "db:reset": "npx --yes supabase db reset",
    "deploy:db": "npx --yes supabase db push",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "npm run preview -w apps/web"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3"
  }
}
